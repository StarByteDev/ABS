APP_NAME="Alpha Block Solutions"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC

# Private production recovery key used by Database Fix and Previous Build Restore.
# Set a long random value in the live .env and never expose it publicly.
ABS_RECOVERY_KEY=

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=abs
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Production: use smtp with your domain mailbox. On compatible shared hosting, sendmail is also supported.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
MAIL_FROM_ADDRESS="noreply@alphablocksolutions.com"
MAIL_FROM_NAME="Alpha Block Solutions"

# Pulse Strategy Lab local defaults.
# Use Admin > Pulse Strategy Lab to change runtime mode/cadence after setup.
PULSE_SCHEDULER_PROFILE=standard
PULSE_CRON_MINUTES=1
PULSE_MARKET_PRICE_REFRESH_SECONDS=60
PULSE_MARKET_READ_MAX_AGE_SECONDS=300
PULSE_SIGNAL_VALIDATION_RETENTION_DAYS=90

# Safety: real-money automation stays OFF unless explicitly enabled later.
PULSE_DISABLE_LIVE_TRADING=true
PULSE_ALLOW_AUTOMATIC_TRADING=false
PULSE_DEFAULT_ENVIRONMENT=testnet

# Optional external integrations. Leave blank for local development.
FMP_API_KEY=

# Economic calendar sources (no key required for the built-in fallbacks)
FINANCE_CALENDAR_ENABLED=true
FINANCE_CALENDAR_URL=https://www.financecalendar.com/wp-json/fc/v1/calendar
XOOMAR_CALENDAR_ENABLED=true
XOOMAR_CALENDAR_URL=https://xoomar.com/api/markets/calendar
XOOMAR_API_KEY=
# Optional additional provider
TRADING_ECONOMICS_FALLBACK_ENABLED=false
TRADING_ECONOMICS_API_KEY=
TRADING_ECONOMICS_CALENDAR_URL=https://api.tradingeconomics.com/calendar

# Email delivery note:
# MAIL_MAILER=log records messages locally but cannot deliver them to an inbox.
# For investor/payment notifications use a real SMTP host (or production sendmail).
# Example: MAIL_MAILER=smtp + your provider's MAIL_HOST/PORT/USERNAME/PASSWORD.
