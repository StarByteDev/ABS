APP_NAME="Alpha Block Solutions"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Dubai
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=10
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=abs
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
CACHE_PREFIX=abs_v14_6_1_mysql
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@alphablocksolutions.com"
MAIL_FROM_NAME="${APP_NAME}"

BINANCE_MARKET_BASE_URL=https://data-api.binance.vision
BINANCE_MARKET_BASE_URLS=https://data-api.binance.vision,https://api.binance.com,https://api1.binance.com
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
FEAR_GREED_BASE_URL=https://api.alternative.me
ALTERNATIVE_CRYPTO_BASE_URL=https://api.alternative.me
ALTERNATIVE_CRYPTO_BASE_URLS=https://api.alternative.me
OKX_MARKET_BASE_URL=https://www.okx.com
OKX_MARKET_BASE_URLS=https://www.okx.com,https://us.okx.com
LIQUIDATION_API_BASE_URL=https://xoomar.com
COINGECKO_API_KEY=
BINANCE_FUTURES_MARKET_BASE_URL=https://fapi.binance.com
BINANCE_FUTURES_MARKET_BASE_URLS=https://fapi.binance.com

# Public live-news feeds. Headlines link to their original publishers.
LIVE_NEWS_ENABLED=true
LIVE_NEWS_CACHE_SECONDS=300
LIVE_NEWS_HTTP_TIMEOUT=6
LIVE_NEWS_CONNECT_TIMEOUT=2
COINDESK_RSS_URL=https://www.coindesk.com/arc/outboundfeeds/rss/
COINTELEGRAPH_RSS_URL=https://cointelegraph.com/rss
DECRYPT_RSS_URL=https://decrypt.co/feed

# Initial administrator created only when the configured Admin account does not already exist. Change before deployment.
ABS_BRAND_TAGLINE="Pulse Trading Intelligence & Private Member Reporting"
ABS_ADMIN_NAME="ABS Administrator"
ABS_ADMIN_EMAIL=admin@alphablocksolutions.local
ABS_ADMIN_PASSWORD="Admin@12345"
MARKET_CACHE_SECONDS=60
MARKET_HTTP_TIMEOUT=7
MARKET_CONNECT_TIMEOUT=3
# XAMPP on Windows can use false locally if its PHP CA bundle is not configured. Set true in production.
MARKET_SSL_VERIFY=false


# Pulse Trading Intelligence — safe execution defaults.
# Live and automatic execution require platform, plan, account and user controls to be enabled.
PULSE_DEFAULT_ENVIRONMENT=testnet
PULSE_DISABLE_LIVE_TRADING=false
PULSE_BINANCE_QUOTE_ASSETS=USDT,USDC
PULSE_ALLOW_AUTOMATIC_TRADING=false

PULSE_SCANNER_TIMEFRAME=15m
PULSE_SCANNER_CANDLE_LIMIT=120
PULSE_SIGNAL_THRESHOLD=65
PULSE_SIGNAL_EXPIRY_MINUTES=90
PULSE_MAX_PAIRS_PER_RUN=1000
PULSE_SCANNER_BATCH_CONCURRENCY=25
PULSE_SCANNER_STALE_RUN_MINUTES=15

PULSE_MAX_LEVERAGE=20
PULSE_MAX_RISK_PER_TRADE=5
PULSE_DEFAULT_STOP_LOSS_PERCENT=1
PULSE_DEFAULT_TAKE_PROFIT_PERCENT=2
PULSE_MIN_NOTIONAL_BUFFER_PERCENT=2

PULSE_AUTOMATION_LOCK_SECONDS=240
PULSE_AUTOMATION_MAX_USERS=25
PULSE_AUTOMATION_MAX_SIGNALS_PER_USER=1

PULSE_BINANCE_TIMEOUT=30
PULSE_BINANCE_CONNECT_TIMEOUT=7
PULSE_BINANCE_RECV_WINDOW=5000
PULSE_BINANCE_PRICE_PROTECT=false
# Set false only on local XAMPP when PHP's CA bundle is not configured. Use true in production.
PULSE_BINANCE_SSL_VERIFY=false
PULSE_BINANCE_TESTNET_URL=https://demo-fapi.binance.com
PULSE_BINANCE_LIVE_URL=https://fapi.binance.com

VITE_APP_NAME="${APP_NAME}"

# ABS V14.8.17 central price + signal intelligence architecture
PULSE_MARKET_PRICE_REFRESH_SECONDS=60
PULSE_MARKET_DATA_LOCK_SECONDS=55
PULSE_MARKET_SCANNER_SYMBOLS_PER_MINUTE=100
PULSE_MARKET_SCANNER_CANDLE_LIMIT=180
PULSE_MARKET_VALIDATION_1M_LIMIT=180
PULSE_MARKET_HTTP_BATCH_SIZE=25
PULSE_SIGNAL_VALIDATION_RETENTION_DAYS=7
PULSE_LEARNING_PRIOR_SAMPLES=20
PULSE_LEARNING_MINIMUM_SAMPLES=20
PULSE_LEARNING_ESTABLISHED_SAMPLES=50
PULSE_LEARNING_CONTEXT_MINIMUM_SAMPLES=40
PULSE_LEARNING_DAILY_DECAY=0.97
